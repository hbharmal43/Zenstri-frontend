# Next.js Environment Variables
NEXT_PUBLIC_FIREBASE_API_KEY=example-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=zenstri-demo.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=zenstri-demo
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=zenstri-demo.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# Vite Compatibility
VITE_FIREBASE_API_KEY=example-api-key
VITE_FIREBASE_AUTH_DOMAIN=zenstri-demo.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=zenstri-demo
VITE_FIREBASE_STORAGE_BUCKET=zenstri-demo.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000
VITE_API_BASE_URL=http://localhost:8080
